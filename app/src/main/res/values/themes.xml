<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SimpleCalculator" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/calculator_operator</item>
        <item name="android:navigationBarColor">@color/calculator_background</item>
        <item name="android:statusBarColor">@color/calculator_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="CalculatorButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/calculator_button</item>
        <item name="android:backgroundTint">@color/calculator_number</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="CalculatorButton.Function">
        <item name="android:backgroundTint">@color/calculator_function</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="CalculatorButton.Operator">
        <item name="android:backgroundTint">@color/calculator_operator</item>
        <item name="android:textSize">34sp</item>
    </style>
</resources>
