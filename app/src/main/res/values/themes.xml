<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SimpleCalculator" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/calculator_operator</item>
        <item name="android:navigationBarColor">@color/calculator_background</item>
        <item name="android:statusBarColor">@color/calculator_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="CalculatorButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/calculator_button</item>
        <item name="android:backgroundTint">@color/calculator_number</item>
        <item name="android:elevation">0dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">23sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CalculatorButton.Function">
        <item name="android:backgroundTint">@color/calculator_function</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="CalculatorButton.Operator">
        <item name="android:backgroundTint">@color/calculator_function</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="CalculatorButton.Equals" parent="CalculatorButton.Operator">
        <item name="android:backgroundTint">@color/calculator_operator</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="ScientificButton" parent="CalculatorButton">
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:backgroundTint">@color/calculator_scientific</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="CalculatorTopButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="CalculatorRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">22dp</item>
        <item name="android:layout_marginEnd">22dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="CalculatorRow.Basic" />
</resources>
